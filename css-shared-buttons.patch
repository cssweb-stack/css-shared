--- /dev/null
+++ b/src/buttons.css
@@ -0,0 +1,88 @@
+/* Shared Buttons */
+.button {
+--button-color: var(--color-blue);
+--button-surface: var(--surface-blue);
+display: inline-flex;
+align-items: center;
+justify-content: center;
+gap: 0.75rem;
+min-width: 44px;
+min-height: 44px;
+max-width: 100%;
+box-sizing: border-box;
+padding: 0.75rem 1.5rem;
+border: 1px solid var(--button-color);
+border-radius: 0.375rem;
+background: var(--button-color);
+color: var(--white);
+font: inherit;
+font-weight: 600;
+line-height: 1.5;
+text-align: center;
+text-decoration: none;
+overflow-wrap: anywhere;
+cursor: pointer;
+}
+
+.button-green {
+--button-color: var(--uh-green);
+}
+
+.button-blue {
+--button-color: var(--color-blue);
+--button-surface: var(--surface-blue);
+}
+
+.button-purple {
+--button-color: var(--color-purple);
+--button-surface: var(--surface-purple);
+}
+
+.button-outline {
+background: var(--white);
+color: var(--button-color);
+}
+
+.button-soft {
+background: var(--button-surface);
+color: var(--button-color);
+}
+
+.button:hover,
+.button:focus-visible {
+background: var(--white);
+color: var(--button-color);
+text-decoration: none;
+}
+
+.button-outline:hover,
+.button-outline:focus-visible,
+.button-soft:hover,
+.button-soft:focus-visible {
+background: var(--button-color);
+color: var(--white);
+}
+
+.button:focus-visible {
+outline: 3px solid var(--button-color);
+outline-offset: 3px;
+}
+
+.button > svg,
+.button-icon,
+.button-icon svg {
+flex: 0 0 1.25rem;
+width: 1.25rem;
+height: 1.25rem;
+fill: currentColor;
+}
+
+.button-arrow {
+justify-content: space-between;
+}
+
+.button-arrow > :last-child {
+flex-shrink: 0;
+font-size: 1.5rem;
+line-height: 1.5;
+}
