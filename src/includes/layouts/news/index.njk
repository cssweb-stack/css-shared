<div class="page-section page-section--gray">
<div class="container content-section">
<div class="row grid-one">
<div class="col-12">
{% for post in collections.unitNews %}
<div class="sidebar-left-med news-index-item">
<a class="news-index-link" href="{{ post.url | url }}">
<img class="photo-style" src="{{ post.data.newsImage.src | url }}" alt="" width="{{ post.data.newsImage.width }}" height="{{ post.data.newsImage.height }}" loading="lazy" decoding="async">
<h2>{{ post.data.title | escape }}</h2>
</a>
<div class="news-index-details">
<p><time datetime="{{ post.data.published | escape }}">{{ post.data.published | newsDate }}</time></p>
<p>{{ post.inputPath | newsOpening | safe }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</div>
</div>
