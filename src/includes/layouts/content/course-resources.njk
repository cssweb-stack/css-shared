{% from "layouts/content/button.njk" import button %}
{% set unitCatalog = catalog_courses.catalog %}
{% if catalog_courses.catalogKey %}{% set unitCatalog = common["uh-catalog"][catalog_courses.catalogKey] %}{% endif %}
<nav class="course-resources" aria-label="{{ site.shortName | escape }} course resources">
<div class="row g-3">
<div class="col-12{% if unitCatalog %} col-md-4{% else %} col-md-6{% endif %}">
{{ button(common.links.classAvailability.label, common.links.classAvailability.url, "teal", "list-check") }}
</div>
<div class="col-12{% if unitCatalog %} col-md-4{% else %} col-md-6{% endif %}">
{% set descriptionLabel = common.links.courseDescriptions.label %}
{% if catalog_courses.prefix %}{% set descriptionLabel = descriptionLabel ~ " (filter by prefix " ~ catalog_courses.prefix ~ ")" %}{% endif %}
{{ button(descriptionLabel, common.links.courseDescriptions.url, "blue", "journal-richtext") }}
</div>
{% if unitCatalog %}
<div class="col-12 col-md-4">
{{ button(unitCatalog.label | default("UH Mānoa Catalog (" ~ site.shortName ~ ")", true), unitCatalog.url, "purple", "book") }}
</div>
{% endif %}
</div>
</nav>
