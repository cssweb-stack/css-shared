{% from "layouts/content/button.njk" import button %}
{% set unitCatalog = catalog_courses.catalog %}
{% if catalog_courses.catalogKey %}{% set unitCatalog = common["uh-catalog"][catalog_courses.catalogKey] %}{% endif %}
<nav class="course-resources{% if unitCatalog %} course-resources--three{% else %} course-resources--two{% endif %}" aria-label="{{ site.shortName | escape }} course resources">
<div class="row g-3 course-resource-grid">
<div class="col-12">
{{ button(common.links.classAvailability.label, common.links.classAvailability.url, "teal", "list-check") }}
</div>
<div class="col-12">
{{ button(common.links.courseDescriptions.label, common.links.courseDescriptions.url, "blue", "journal-richtext") }}
</div>
{% if unitCatalog %}
<div class="col-12">
{{ button("UH Mānoa Catalog", unitCatalog.url, "purple", "book") }}
</div>
{% endif %}
</div>
{% if catalog_courses.prefix %}<p class="info course-resources-note"><span>For course descriptions, filter by prefix <strong>{{ catalog_courses.prefix | escape }}</strong>.</span></p>{% endif %}
</nav>
