{% from "layouts/profiles/contact-links.njk" import contactLinks %}
{% set building = common.buildings[site.building] %}
{% set buildingPhoto = site.buildingPhoto | default(building.photo, true) %}
{% if building %}
<section class="row gy-4 grid-spaced unit-contact gx-0 gx-md-5" aria-label="Main office location and directions">
<div class="col-12 col-md-4 unit-contact-office">
<div class="office-card">
{% if buildingPhoto and buildingPhoto.src %}
<img class="photo-style" src="{{ buildingPhoto.src | url }}" alt="{{ buildingPhoto.alt | escape }}" width="{{ buildingPhoto.width }}" height="{{ buildingPhoto.height }}" loading="lazy" decoding="async">
{% endif %}
<h2>Main Office</h2>
<div class="profile-contact">
<address class="contact-address">
{% if site.address | length %}
{% for line in site.address %}<p>{{ line | escape }}</p>{% endfor %}
{% endif %}
</address>
{{ contactLinks(site.email.label, site.email.contactHref | default(site.email.href), site.phone.label, site.phone.href) }}
</div>
</div>
</div>
{% if building.mapEmbedUrl %}
<div class="col-12 col-md-8 unit-contact-map">
<iframe class="map-embed" title="Google Map showing {{ building.name | escape }} at UH Mānoa" src="{{ building.mapEmbedUrl | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>
{% endif %}
</section>
{% endif %}
