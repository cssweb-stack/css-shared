<div>
{% for lecture in events %}
{% set date = lecture.date | eventDate %}
<div class="sidebar-left-exsm">
<div class="event-date-box tile-style tile-blue" aria-hidden="true">
<span class="event-calendar-icon" aria-hidden="true">{% include "media/icons/calendar3.svg" %}</span>
<span class="event-compact-date">{{ date.compact | escape }}</span>
</div>
<section aria-labelledby="event-title-{{ loop.index }}">
<h2 id="event-title-{{ loop.index }}">{% if lecture.url %}<a href="{{ lecture.url | escape }}">{{ lecture.title | escape }}</a>{% else %}{{ lecture.title | escape }}{% endif %}</h2>
<ul>
{% if lecture.speaker %}
<li class="lecture-speaker">{{ lecture.speaker | escape }}</li>
{% endif %}
{% if lecture.affiliation %}
<li>{{ lecture.affiliation | escape }}</li>
{% endif %}
<li><time datetime="{{ date.iso | escape }}">{{ date.full | escape }}</time>{% if lecture.time %} at {{ lecture.time | escape }}{% endif %}</li>
{% if lecture.location %}
<li>{{ lecture.location | escape }}</li>
{% endif %}
</ul>
</section>
</div>
{% endfor %}
</div>
