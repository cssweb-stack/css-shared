{# Register the shared event-date.cjs formatter as the eventDate filter.
Set a unique id and retain the page's heading level. Optional caller content
preserves descriptions, links, and other event information before the date. #}
{% macro eventItem(item, id, headingLevel=3) %}
{% set date = item.date | eventDate %}
<article class="media-row" aria-labelledby="{{ id | escape }}">
<div class="event-date-box tile tile-blue media-visual" aria-hidden="true">
<img class="event-calendar-icon" src="{{ '/media/icons/calendar3-white.svg' | url }}" alt="">
<span class="event-compact-date">{{ date.compact | escape }}</span>
</div>
<div class="event-content">
<h{{ headingLevel }} id="{{ id | escape }}" class="event-title">{{ item.title | escape }}</h{{ headingLevel }}>
{% if item.speaker %}<p class="event-speaker">{{ item.speaker | escape }}</p>{% endif %}
{% if item.affiliation %}<p class="event-affiliation">{{ item.affiliation | escape }}</p>{% endif %}
{% if caller %}{{ caller() }}{% endif %}
<p class="event-date"><span class="action-chevron" aria-hidden="true"></span><time datetime="{{ date.iso | escape }}">{{ date.full | escape }}</time></p>
</div>
</article>
{% endmacro %}
