{% set profileUrl = person.url | default(site.facultyBasePath + person.slug + '.html') %}
{% if profileView == "directory" %}
<a class="profile-link" href="{{ profileUrl | url }}">
{% if person.photo %}<img class="profile-directory-photo photo-style" src="{{ person.photo | url }}" alt="{{ person.name | escape }}" width="{{ person.photoWidth | default(400) }}" height="{{ person.photoHeight | default(400) }}" loading="lazy" decoding="async">{% endif %}
<h2 id="faculty-{{ person.slug | escape }}" class="profile-name">{{ person.name | escape }}</h2>
</a>
{% else %}
{% if person.photo %}<img class="profile-photo photo-style" src="{{ person.photo | url }}" alt="{{ person.name | escape }}" width="{{ person.photoWidth | default(400) }}" height="{{ person.photoHeight | default(400) }}" decoding="async">{% endif %}
<h1 class="profile-name">{{ person.name | escape }}</h1>
{% endif %}
{% if person.title or person.roles | length %}<div class="profile-titles">
{% if person.title %}<p class="profile-job-title">{{ person.title | escape }}</p>{% endif %}
{% if person.roles | length %}
{% for role in person.roles %}<p class="profile-admin-title">{{ role | escape }}</p>{% endfor %}
{% endif %}
</div>{% endif %}
{% include "layouts/profiles/profile-contact.njk" %}
