{% from "layouts/profiles/contact-links.njk" import contactLinks %}
{% if advising.people | length %}
<section class="grid-spaced" aria-labelledby="undergraduate-advising-heading">
<h2 id="undergraduate-advising-heading">{{ site.shortName | escape }} {{ advising.heading | default('Undergraduate Advising') | escape }}</h2>
{% if advising.intro %}
<p>{{ advising.intro | escape }}</p>
{% endif %}
<div class="grid-two undergraduate-advisors-grid">
{% for advisor in advising.people %}
<div class="grid-two advisor-pair">
{% if advisor.photo %}
<div class="advisor-photo">
<img class="photo-style" src="{{ advisor.photo | url }}" alt="{{ advisor.name | escape }}" width="112" height="112" loading="lazy" decoding="async">
</div>
{% endif %}
<div>
<h3 class="profile-name">{% if advisor.url %}<a href="{{ advisor.url | url }}">{{ advisor.name | escape }}</a>{% else %}{{ advisor.name | escape }}{% endif %}</h3>
{% if advisor.title or advisor.role %}
<div class="profile-titles">
{% if advisor.title %}
<p class="profile-job-title">{{ advisor.title | escape }}</p>
{% endif %}
{% if advisor.role %}
<p class="profile-admin-title">{{ advisor.role | escape }}</p>
{% endif %}
</div>
{% endif %}
{% if advisor.email %}
<address class="profile-contact">
{{ contactLinks(advisor.email, "mailto:" + advisor.email) }}
</address>
{% endif %}
</div>
</div>
{% endfor %}
</div>
</section>
{% endif %}
