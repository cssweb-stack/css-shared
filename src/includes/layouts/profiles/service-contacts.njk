{# Service assignments reuse the people-directory styles and central people records. #}
{% from "layouts/content/section-heading.njk" import sectionHeading with context %}
{% for group in people.serviceGroups[servicePage] %}
<section class="people-directory-section" aria-labelledby="directory-{{ group.id }}">
{{ sectionHeading(group.title, "directory-" + group.id) }}
<div class="people-directory people-directory--service{% if group.showSupport %} people-directory--assignments{% endif %}">
<div class="people-directory-head" aria-hidden="true">
<span>Name</span><span>Email</span>{% if group.showSupport %}<span>Providing support for</span>{% endif %}
</div>
{% for member in group.members %}
{% set person = people.records[member.person] %}
<article class="people-directory-entry" aria-labelledby="directory-{{ group.id }}-{{ loop.index }}">
<h3 class="people-directory-name" id="directory-{{ group.id }}-{{ loop.index }}">{% if member.vacant %}TBD{% else %}{{ person.name | escape }}{% endif %}</h3>
<p class="people-directory-email email"><span class="icon-text"><span class="people-directory-label">Email: </span>{% if member.vacant %}TBD{% else %}<a href="{{ person.email.href | escape }}">{{ person.email.label | escape }}</a>{% endif %}</span></p>
{% if group.showSupport %}<p class="people-directory-support"><span class="people-directory-label">Providing support for: </span>{{ member.support | escape }}</p>{% endif %}
</article>
{% endfor %}
</div>
</section>
{% endfor %}
