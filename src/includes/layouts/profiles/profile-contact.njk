{% from "layouts/profiles/contact-links.njk" import contactLinks %}
{% if person.office or person.phone or person.email %}
<address class="profile-contact">
{% if person.office %}
{% if person.title or person.roles | length %}<hr class="profile-contact-divider">{% endif %}
<p class="profile-office profile-detail">{{ person.office | escape }}</p>
{% endif %}
{{ contactLinks(person.email, 'mailto:' + person.email, person.phone, 'tel:' + (person.phoneHref | default(person.phone | telephone))) }}
</address>
{% endif %}
