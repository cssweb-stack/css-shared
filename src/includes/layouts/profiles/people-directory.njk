{# People records share one markup structure across all responsive layouts. #}
{% from "layouts/content/section-heading.njk" import sectionHeading with context %}
{% for group in directoryGroups | default(people.directoryGroups) %}
<section class="people-directory-section" aria-labelledby="directory-{{ group.id }}">
{{ sectionHeading(group.title, "directory-" + group.id, divider=not loop.first) }}
<div class="people-directory{% if not group.showTelephone %} people-directory--no-phone{% endif %}">
<div class="people-directory-head" aria-hidden="true">
<span>Name</span><span>Title</span><span>Office</span>{% if group.showTelephone %}<span>Telephone</span>{% endif %}<span>Email</span>
</div>
{% for member in group.members %}
{% set person = people.records[member] %}
<article class="people-directory-entry" aria-labelledby="directory-{{ group.id }}-{{ member }}">
<h3 class="people-directory-name" id="directory-{{ group.id }}-{{ member }}">{% if person.profileUrl %}<a href="{{ person.profileUrl | url | escape }}">{{ person.name | escape }}</a>{% else %}{{ person.name | escape }}{% endif %}</h3>
<p class="people-directory-title"><span class="people-directory-label">Title: </span>{{ person.title | escape }}</p>
<p class="people-directory-office"><span class="people-directory-label">Office: </span>{{ person.office | escape }}</p>
{% if group.showTelephone %}
<p class="people-directory-phone phone"><span class="icon-text"><span class="people-directory-label">Telephone: </span>{% if person.phone.href %}<a href="{{ person.phone.href | escape }}">{{ person.phone.label | escape }}</a>{% else %}{{ person.phone.label | escape }}{% endif %}</span></p>
{% endif %}
<p class="people-directory-email email"><span class="icon-text"><span class="people-directory-label">Email: </span><a href="{{ person.email.href | escape }}">{{ person.email.label | escape }}</a></span></p>
</article>
{% endfor %}
</div>
</section>
{% endfor %}
