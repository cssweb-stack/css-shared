<div class="row gy-5 gx-0 gx-sm-5 gx-lg-5">
{% for student in students %}
<div class="col-12 col-md-2">
<img class="photo-style grid-photo" src="{{ student.photo | url }}" alt="{{ student.name | escape }}" width="212" height="212" loading="lazy" decoding="async">
</div>
<div class="col-12 col-md-10">
<section aria-labelledby="student-heading-{{ loop.index }}">
<h2 id="student-heading-{{ loop.index }}">{{ student.name | escape }} <span class="accent">({{ student.program | escape }})</span></h2>
{% if student.email %}
<p><i class="bi bi-envelope" aria-hidden="true"></i> <a href="mailto:{{ student.email | escape }}">{{ student.email | escape }}</a></p>
{% endif %}
<p>{{ student.research | escape }}</p>
<p><strong>Advisor:</strong> {{ student.advisorName | escape }}</p>
</section>
</div>
{% endfor %}
</div>
