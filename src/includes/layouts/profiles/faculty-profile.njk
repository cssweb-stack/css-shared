---
layout: shell.njk
---
<div class="page-section">
<div class="container content-section">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12">
<div class="{% if site.sidebarLeftLayouts %}sidebar-left-med profile-page{% else %}row gy-4 gx-0 gx-md-5 profile-page{% endif %}">
<div class="{% if not site.sidebarLeftLayouts %}col-12 col-md-4 {% endif %}profile-sidebar">
{% include "layouts/profiles/profile-sidebar.njk" %}
</div>
<div class="{% if not site.sidebarLeftLayouts %}col-12 col-md-8 {% endif %}profile-biography">
{% if person.researchInterests %}
<h2>Research Interests</h2>
<p>{{ person.researchInterests | escape }}</p>
{% endif %}
{{ content | safe }}
</div>
</div>
</div>
</div>
</div>
</div>
