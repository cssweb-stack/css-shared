<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{{ title | escape }} | CSS Review</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/review.css" rel="stylesheet">
</head>
<body>
<header class="sticky-header">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="review-banner">
<div class="container unit-name-inner">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12 unit-name-row">
<a class="unit-name-link" href="/index.html">CSS Review</a>
<button class="unit-icon-button unit-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#unitNavigation" aria-controls="unitNavigation" aria-expanded="false" aria-label="Toggle review navigation">
{% include "media/icons/list.svg" %}
</button>
</div>
</div>
</div>
</div>
{% include "layouts/branding/header/unit-nav.njk" %}
</header>
<main id="main-content" class="site-main" tabindex="-1">
{% if reviewSection %}
<div class="page-section">
<div class="container content-section">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12">
{% if reviewSection == "rules" %}
{% set degreeNavigation = {label: "Rules", pages: [{label: "Code Formatting", url: "/rules/code-formatting.html"}, {label: "Language & Writing", url: "/rules/language-writing.html"}]} %}
{% else %}
{% set degreeNavigation = reviewNavigation[reviewSection] %}
{% endif %}
{% include "layouts/content/degree-navigation.njk" %}
</div>
</div>
</div>
</div>
{% endif %}
<div class="page-section">
<div class="container content-section">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12">
<h1>{{ title | escape }}</h1>
{{ content | safe }}
</div>
</div>
</div>
</div>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="/assets/js/site.js" defer></script>
</body>
</html>
