{# Shared policy and identity data. #}
{% set footerPrivacy = uh.footer.privacy | default(site.privacy, true) %}
{% set footerWebmaster = uh.footer.webmaster | default(site.webmaster, true) %}
{% set footerLanguageId = footerId | default("footer") + "-language-heading" %}
{% set footerLinks = site.footer.links | default(uh.footer.footerLinks, true) %}
{# Support older grouped unit overrides while rendering one continuous list. #}
{% if site.footer.columns and not site.footer.links %}
{% set footerLinks = [] %}
{% for column in site.footer.columns %}{% set footerLinks = footerLinks.concat(column) %}{% endfor %}
{% endif %}
{% set footerShowHeading = site.footer.language.showHeading | default(uh.footer.language.showHeading) %}
{% set footerLanguagePresentation = site.footer.language.presentation | default(uh.footer.language.presentation) %}
{% set footerDesktopBackground = site.footer.background.desktopTablet | default(uh.footer.background.desktopTablet) %}
{% set footerMobileBackground = site.footer.background.mobile | default(uh.footer.background.mobile) %}
<footer class="site-footer site-footer--languages-{{ footerLanguagePresentation | escape }}" style="--footer-background-desktop: url('{{ footerDesktopBackground | url | escape }}'); --footer-background-mobile: url('{{ footerMobileBackground | url | escape }}');">

{# Upper footer: one unit column and three university-link columns. #}
<div class="container footer-inner">
<div class="row gx-lg-5 footer-grid">
<div class="col-12 col-lg-3 footer-unit-column">
<div class="row gx-0 gx-sm-5 footer-unit-layout">
<div class="col-12 col-sm-6 col-lg-12 footer-unit-identity">
{% if site.shortName %}
<p class="footer-unit-short-name">{{ site.shortName | escape }}</p>
{% endif %}
<p class="footer-unit-name">{% if site.footerIdentity.prefix %}<span class="footer-unit-prefix">{{ site.footerIdentity.prefix | escape }}</span> {% endif %}{{ site.footerIdentity.name | default(site.name) | escape }}</p>
<ul class="footer-parent-links">
{% if site.shortName != 'CSS' %}
<li><a href="{{ common.links.college.url | escape }}">{{ common.links.college.label | escape }}</a></li>
{% endif %}
<li><a href="{{ common.links.university.url | escape }}">{{ common.links.university.label | escape }}</a></li>
</ul>

</div>
<address class="col-12 col-sm-6 col-lg-12 footer-contact">
{% if site.address | length %}
<div class="footer-address">{% for line in site.address %}<p>{{ line | escape }}</p>{% endfor %}</div>
{% endif %}

{% if site.phone %}
<p class="footer-phone">
<a class="footer-contact-link" href="{{ site.phone.href | escape }}">
<span aria-hidden="true">{% include "media/icons/telephone.svg" %}</span>
<span>{{ site.phone.label | escape }}</span>
</a>
</p>
{% endif %}

{% if site.email %}
<p class="footer-email">
<a class="footer-contact-link" href="{{ site.email.href | escape }}">
<span aria-hidden="true">{% include "media/icons/envelope.svg" %}</span>
<span>{{ site.email.label | escape }}</span>
</a>
</p>
{% endif %}

{# Count populated entries, not the eight available platform slots. #}
{% set footerSocialLinks = social.links | default([], true) %}
{% set footerSocialCount = 0 %}
{% for link in footerSocialLinks %}
{% if (link.url | default('', true) | trim) and link.icon %}{% set footerSocialCount = footerSocialCount + 1 %}{% endif %}
{% endfor %}
{% if footerSocialCount %}
<ul class="footer-social-bar" aria-label="{{ site.shortName | default(site.name, true) | escape }} social media">
{% for link in footerSocialLinks | sort(false, false, 'label') %}
{% if (link.url | default('', true) | trim) and link.icon %}
<li class="footer-social-item">
<a class="footer-social-link" href="{{ link.url | trim | escape }}" aria-label="{{ site.shortName | default(site.name, true) | escape }} on {{ link.label | escape }}">
<span class="footer-social-icon" aria-hidden="true">{% include "media/icons/" + link.icon + ".svg" %}</span>
</a>
</li>
{% endif %}
{% endfor %}
</ul>
{% endif %}

{% if footerWebmaster or footerPrivacy %}
<hr class="footer-contact-divider" aria-hidden="true">
<p class="footer-contact-meta">
{% if footerWebmaster %}
<a href="mailto:{{ footerWebmaster.email | escape }}">{{ footerWebmaster.label | escape }}</a>
{% endif %}
{% if footerWebmaster and footerPrivacy %}
<span aria-hidden="true">&middot;</span>
{% endif %}
{% if footerPrivacy %}
<a href="{{ footerPrivacy.url | url }}">{{ footerPrivacy.label | escape }}</a>
{% endif %}
</p>
{% endif %}
</address>
</div>
</div>
<nav class="col-12 col-lg-9 footer-university-links" aria-label="Footer links">
<ul class="footer-link-list">
{% for link in footerLinks %}
<li><a href="{{ link.url | url | escape }}">{{ link.label | escape }}</a></li>
{% endfor %}
</ul>
</nav>
</div>
</div>

{# Language labels and destinations are shared by both presentations. #}
<nav class="footer-language-band" {% if footerShowHeading %}aria-labelledby="{{ footerLanguageId | escape }}"{% else %}aria-label="{{ uh.languages.heading | escape }}"{% endif %}>
{% if footerShowHeading %}
<div class="footer-language-heading-bar">
<div class="container">
<p id="{{ footerLanguageId | escape }}">
{{ uh.languages.heading | escape }} <span class="footer-language-about">| <a href="{{ common.links.languageAccess.url | escape }}">About these services</a></span>
</p>
</div>
</div>

{% endif %}
<div class="footer-language-links">
<div class="container">
<ul class="footer-languages footer-grid-eight">
{% for language in uh.languages.items %}
<li>
<a href="{{ language.url | escape }}" lang="{{ language.lang | escape }}">{{ language.label | escape }}</a>
</li>
{% endfor %}
</ul>
</div>
</div>
</nav>

{# Shared subfooter. #}
{% include "layouts/branding/footer/subfooter.njk" %}

</footer>
