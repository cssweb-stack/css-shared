{% set headerIdPrefix = headerId + "-" if headerId else "" %}
<nav class="unit-nav navbar navbar-expand-xl" aria-label="{{ site.shortName | escape }} navigation">
<div class="container">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12">
<div class="collapse navbar-collapse" id="{{ headerIdPrefix }}unitNavigation">
<ul class="navbar-nav">
{% for item in navigation -%}
{% if item.children -%}
<li class="nav-item dropdown">
<button class="nav-link dropdown-toggle nav-trigger"
type="button"
id="{{ headerIdPrefix }}navItem{{ loop.index }}"
data-bs-toggle="dropdown"
aria-expanded="false">{% if item.icon %}<span class="nav-main-icon"{% if item.iconColor %} style="--nav-icon-color: {{ item.iconColor | navIconColor }}"{% endif %} aria-hidden="true">{% include "media/icons/" + item.icon + ".svg" %}</span>{% endif %}{{ item.label | escape }}</button>
<ul class="dropdown-menu" aria-labelledby="{{ headerIdPrefix }}navItem{{ loop.index }}">
{% for child in item.children -%}
<li>
<a class="dropdown-item" href="{{ child.url | url }}">
{% if child.icon -%}
<span class="nav-menu-icon-wrap"{% if child.iconColor %} style="--nav-icon-color: {{ child.iconColor | navIconColor }}"{% endif %} aria-hidden="true">{% include "media/icons/" + child.icon + ".svg" %}</span>
{% endif -%}
<span>{{ child.label }}</span>
</a>
</li>
{% endfor -%}

</ul>
</li>
{% else -%}
<li class="nav-item">
<a class="nav-link" href="{{ item.url | url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{% if item.icon %}<span class="nav-main-icon"{% if item.iconColor %} style="--nav-icon-color: {{ item.iconColor | navIconColor }}"{% endif %} aria-hidden="true">{% include "media/icons/" + item.icon + ".svg" %}</span>{% endif %}{{ item.label | escape }}</a>
</li>
{% endif -%}
{% endfor -%}
{# Same university data as the green bar, presented within the collapsed menu. #}
<li class="nav-item dropdown d-xl-none">
<button class="nav-link dropdown-toggle nav-trigger" type="button"
id="{{ headerIdPrefix }}uhLinksToggle" data-bs-toggle="dropdown" aria-expanded="false">UH links</button>
<ul class="dropdown-menu" aria-labelledby="{{ headerIdPrefix }}uhLinksToggle">
{% for link in uh.header.navigation %}
<li><a class="dropdown-item" href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
{% endfor %}
</ul>
</li>
</ul>
</div>
</div>
</div>
</div>
</nav>
