{% set headerIdPrefix = headerId + "-" if headerId else "" %}
<div class="unit-name"><div class="container unit-name-inner">
<div class="row gx-0 gx-sm-5 gx-lg-5">
<div class="col-12">
<div class="unit-name-row">
<a href="{{ "/" | url }}" class="unit-name-link">{{ site.name | escape }}{% if site.showShortName and site.shortName %} <span class="unit-short-name">{{ site.shortName | escape }}</span>{% endif %}</a>
<div class="unit-actions">
<form class="desktop-search" role="search" autocomplete="off" action="https://www.google.com/search" method="get">
<label class="visually-hidden" for="{{ headerIdPrefix }}unit-search-desktop">Search {{ site.search.label | default(site.shortName) | escape }} website</label>
<input id="{{ headerIdPrefix }}unit-search-desktop" class="form-control form-control-sm" type="search" autocomplete="off" name="q" placeholder="Search {{ site.shortName | escape }}" required>
<input type="hidden" name="sitesearch" value="{{ site.search.domain | escape }}">
<button class="btn btn-outline-secondary desktop-search-submit" type="submit" aria-label="Search {{ site.search.label | default(site.shortName) | escape }} website">{% include "media/icons/search.svg" %}</button>
</form>
<button class="unit-icon-button unit-search-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#{{ headerIdPrefix }}mobileSearch" aria-controls="{{ headerIdPrefix }}mobileSearch" aria-expanded="false" aria-label="Toggle site search">{% include "media/icons/search.svg" %}</button>
<button class="unit-icon-button unit-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#{{ headerIdPrefix }}unitNavigation" aria-controls="{{ headerIdPrefix }}unitNavigation" aria-expanded="false" aria-label="Toggle unit navigation">{% include "media/icons/list.svg" %}</button>
</div>
</div>
<div class="collapse mobile-search" id="{{ headerIdPrefix }}mobileSearch"><form role="search" autocomplete="off" action="https://www.google.com/search" method="get" class="mobile-search-form">
<label class="visually-hidden" for="{{ headerIdPrefix }}unit-search-mobile">Search {{ site.search.label | default(site.shortName) | escape }} website</label>
<input id="{{ headerIdPrefix }}unit-search-mobile" class="form-control" type="search" autocomplete="off" name="q" placeholder="Search {{ site.shortName | escape }}" required>
<input type="hidden" name="sitesearch" value="{{ site.search.domain | escape }}">
<button class="btn btn-outline-secondary" type="submit">Search</button>
</form></div>
</div>
</div>
</div></div>
