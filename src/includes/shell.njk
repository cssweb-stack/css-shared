<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
{% include "analytics.njk" -%}
{% if isNotFound or not site.indexingEnabled %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preload" href="{{ '/assets/fonts/InterVariable.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/media/branding/favicon/apple-touch-icon.png' | url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ '/media/branding/favicon/favicon-32x32.png' | url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ '/media/branding/favicon/favicon-16x16.png' | url }}">
<meta name="description" content="{{ description | default(site.name) | escape }}">
{% if canonicalUrl -%}
<link rel="canonical" href="{{ canonicalUrl | escape }}">
{% endif -%}
<title>{{ title | default(site.name) | escape }} | {{ site.name }}</title>
{% if site.openGraph.image and site.url %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name | escape }}">
<meta property="og:title" content="{{ title | default(site.name) | escape }} | {{ site.name | escape }}">
<meta property="og:description" content="{{ description | default(site.name) | escape }}">
<meta property="og:url" content="{{ page.url | socialUrl | escape }}">
<meta property="og:image" content="{{ site.openGraph.image | socialUrl | escape }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="{{ site.openGraph.width }}">
<meta property="og:image:height" content="{{ site.openGraph.height }}">
<meta property="og:image:alt" content="{{ site.openGraph.alt | escape }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title | default(site.name) | escape }} | {{ site.name | escape }}">
<meta name="twitter:description" content="{{ description | default(site.name) | escape }}">
<meta name="twitter:image" content="{{ site.openGraph.image | socialUrl | escape }}">
<meta name="twitter:image:alt" content="{{ site.openGraph.alt | escape }}">
{% endif %}
{% if site.searchConsoleVerificationToken %}
<meta name="google-site-verification" content="{{ site.searchConsoleVerificationToken | escape }}">
{% endif %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ site.stylesheet | default("/geo.css") | url }}" rel="stylesheet">
</head>
<body>
<header class="sticky-header">
<a class="skip-link" href="#main-content">Skip to main content</a>
{% include "layouts/branding/header/uh-brand.njk" -%}
{% include "layouts/branding/header/unit-name.njk" -%}
{% include "layouts/branding/header/unit-nav.njk" -%}
</header>
{% if site.hero.enabled != false %}{% include "layouts/hero/hero.njk" %}{% endif -%}
{# One universal content parent; site-main owns page-edge spacing. #}
<main id="main-content" class="site-main">
{{ content | safe }}
</main>
{% if site.hero.enabled != false %}{% include "layouts/hero/hero-attribution.njk" %}{% endif -%}
{% include "layouts/branding/footer/footer.njk" -%}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="{{ "/assets/js/site.js" | url }}" defer></script>
</body>
</html>
