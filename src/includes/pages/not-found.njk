{% set recovery = not_found | default({}) %}
<div class="page-section">
<div class="container content-section">
<div class="row gy-4 gx-0 gx-md-5 profile-page not-found-grid">
<div class="col-12 col-md-4 profile-sidebar not-found-code-column">
<p class="not-found-code" aria-hidden="true">404</p>
</div>
<div class="col-12 col-md-8 profile-biography">
<h1>404 Page Not Found</h1>
<p>We couldn’t find the page you requested. We’ve recently updated this website, so the page may have moved or been retired. Use the navigation menu or the search feature in the navigation bar to find what you need, or try the links below.</p>
<ul class="not-found-links">
{% for link in recovery.quickLinks %}
<li><a href="{{ link.url | url | escape }}">{{ link.label | escape }}</a></li>
{% else %}
<li><a href="{{ '/' | url }}">{{ site.shortName | default(site.name) | escape }} homepage</a></li>
{% endfor %}
</ul>
</div>
</div>
</div>
</div>
