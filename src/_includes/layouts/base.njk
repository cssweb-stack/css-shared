<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="apple-touch-icon" sizes="180x180" href="{{ '/_media/branding/favicon/apple-touch-icon.png' | url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ '/_media/branding/favicon/favicon-32x32.png' | url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ '/_media/branding/favicon/favicon-16x16.png' | url }}">
<meta name="description" content="{{ description | default(site.name) | escape }}">
<title>{{ title | default(site.name) | escape }} | {{ site.name }}</title>
{# Keep existing Search Console verification file and/or meta tag when eventually migrating #}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="{{ "/common.css" | url }}" rel="stylesheet">
<link href="{{ "/shell.css" | url }}" rel="stylesheet">
<link href="{{ "/geo.css" | url }}" rel="stylesheet">
</head>
<body>
<header class="sticky-header">
<a class="skip-link" href="#main-content">Skip to main content</a>
{% include "components/uh-brand.njk" %}
{% include "components/unit-name.njk" %}
{% include "components/unit-nav.njk" %}
</header>
{% if site.hero.enabled != false %}{% include "components/hero.njk" %}{% endif %}
<main id="main-content" class="site-main">
<div class="container main-content">
{% if not hidePageTitle %}<h1>{{ title | default(site.name) | escape }}</h1>{% endif %}
{{ content | safe }}
</div>
</main>
{% if site.hero.enabled != false %}{% include "components/hero-attribution.njk" %}{% endif %}
{% include "components/footer.njk" %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
<script src="{{ "/assets/site.js" | url }}" defer></script>
</body>
</html>
