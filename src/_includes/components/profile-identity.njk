{% set profileUrl = person.url | default(site.facultyBasePath + person.slug + '.html') %}
{% if profileView == "directory" %}
<a class="profile-link" href="{{ profileUrl | url }}">
{% if person.photo %}<img class="profile-directory-photo photo-frame photo-frame-large" src="{{ person.photo | url }}" alt="" width="{{ person.photoWidth | default(400) }}" height="{{ person.photoHeight | default(400) }}" loading="lazy" decoding="async">{% endif %}
<h2 id="faculty-{{ person.slug | escape }}" class="profile-name">{{ person.name | escape }}</h2>
</a>
{% else %}
{% if person.photo %}<img class="profile-photo photo-frame photo-frame-large" src="{{ person.photo | url }}" alt="{{ person.name | escape }}" width="{{ person.photoWidth | default(400) }}" height="{{ person.photoHeight | default(400) }}" decoding="async">{% endif %}
<h1 class="profile-page-name">{{ person.name | escape }}</h1>
{% endif %}
{% if person.title or person.role %}<div class="profile-titles">
{% if person.title %}<p class="profile-title">{{ person.title | escape }}</p>{% endif %}
{% if person.role %}<p class="profile-role">{{ person.role | escape }}</p>{% endif %}
</div>{% endif %}
{% include "components/profile-contact.njk" %}
{% if person.keywords | length %}<p class="profile-keywords">{{ person.keywords | join(', ') | escape }}</p>{% endif %}
