<footer class="site-footer">
<div class="container footer-inner">
<div class="footer-grid">
<div class="footer-branding">
{% if site.logo %}<img class="footer-department-logo" src="{{ site.logo.src | url }}" alt="{{ site.logo.alt | escape }}" width="{{ site.logo.width }}" height="{{ site.logo.height }}" loading="lazy">{% endif %}
<div class="footer-department-links">
{% if site.privacy %}<p class="footer-department-privacy"><a href="{{ site.privacy.url | url }}">{{ site.privacy.label | escape }}</a></p>{% endif %}
{% if site.webmaster %}<p class="footer-department-webmaster"><a href="mailto:{{ site.webmaster.email | escape }}"><span aria-hidden="true">{% include "icons/envelope.svg" %}</span><span>{{ site.webmaster.label | escape }}</span></a></p>{% endif %}
</div>
</div>
<div class="footer-department">
<p class="footer-department-name">{% if site.prefix %}<span>{{ site.prefix | escape }}</span><br>{{ site.name | replace(site.prefix + ' ', '') | escape }}{% else %}{{ site.name | escape }}{% endif %}</p>
<address class="footer-contact">
{% if site.address | length %}<p>{% for line in site.address %}{{ line | escape }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>{% endif %}
{% if site.phone %}<p><a class="footer-contact-link" href="{{ site.phone.href | escape }}"><span aria-hidden="true">{% include "icons/telephone.svg" %}</span><span>{{ site.phone.label | escape }}</span></a></p>{% endif %}
{% if site.email %}<p><a class="footer-contact-link" href="{{ site.email.href | escape }}"><span aria-hidden="true">{% include "icons/envelope.svg" %}</span><span>{{ site.email.label | escape }}</span></a></p>{% endif %}
{% for link in site.socialLinks %}<p><a class="footer-contact-link" href="{{ link.url | url }}">{% if link.icon %}<span aria-hidden="true">{% include "icons/" + link.icon + ".svg" %}</span>{% endif %}<span>{{ link.label | escape }}</span></a></p>{% endfor %}
</address>
</div>
{% for column in university.footerColumns %}
<div class="footer-links"><ul class="footer-link-list">
{% for link in column %}<li><a href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>{% endfor %}
</ul></div>
{% endfor %}
</div>
</div>
<nav class="footer-language-band" aria-labelledby="footer-language-heading">
<div class="footer-language-heading-bar"><p id="footer-language-heading">{{ university.interpretationHeading | escape }}</p></div>
<div class="footer-language-links"><div class="container"><ul class="footer-languages">
{% for language in university.languages %}<li><a href="{{ language.url | escape }}" lang="{{ language.lang | escape }}">{{ language.label | escape }}</a></li>{% endfor %}
</ul></div></div>
</nav>
{% include "components/subfooter.njk" %}
</footer>
