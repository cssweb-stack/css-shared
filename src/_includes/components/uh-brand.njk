<div class="uh-brand">
<div class="container">

<nav class="navbar navbar-expand-xl navbar-dark" aria-label="University of Hawaiʻi navigation">

<!-- University Logo -->
<a class="navbar-brand" href="{{ university.logo.url | escape }}">
<img
src="{{ university.logo.src | url }}"
alt="{{ university.logo.alt | escape }}"
class="uh-brand-logo">
</a>

<!-- Mobile Hamburger -->
<button
class="navbar-toggler"
type="button"
data-bs-toggle="collapse"
data-bs-target="#uhBrandNav"
aria-controls="uhBrandNav"
aria-expanded="false"
aria-label="Toggle university navigation">
<span class="navbar-toggler-icon"></span>
</button>

<!-- University Navigation -->
<div class="collapse navbar-collapse" id="uhBrandNav">
<ul class="navbar-nav">

{% for link in university.navigation %}
<li class="nav-item"><a class="nav-link" href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
{% endfor %}
</ul>
</div>

</nav>

</div>
</div>
