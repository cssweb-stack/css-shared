{% set profileView = "profile" %}
{% include "components/profile-identity.njk" %}
{% if person.links | length %}
<ul class="profile-personal-links" aria-label="{{ person.name | escape }}: websites and social profiles">
{% for link in person.links %}<li><a href="{{ link.url | escape }}">{{ link.label | escape }}<span class="visually-hidden"> — {{ person.name | escape }}</span></a></li>{% endfor %}
</ul>
{% endif %}
{% if person.publications | length %}
{% include "components/divider-medium.njk" %}
<section class="profile-publications" aria-labelledby="profile-publications-heading">
<h2 id="profile-publications-heading">Browse My Publications</h2>
<ul class="profile-publication-links">
{% for publication in person.publications %}<li><a href="{{ publication.url | escape }}"><img src="{{ publication.image | url }}" alt="{{ person.name | escape }} on {{ publication.label | escape }}" width="450" height="96" loading="lazy" decoding="async"></a></li>{% endfor %}
</ul>
</section>
{% endif %}
