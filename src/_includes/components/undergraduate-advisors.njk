{% if advising.people | length %}
<section class="advising" aria-labelledby="undergraduate-advising-heading">
<h2 id="undergraduate-advising-heading">{{ site.shortName | escape }} {{ advising.heading | default('Undergraduate Advising') | escape }}</h2>
{% if advising.intro %}<p class="advising-intro">{{ advising.intro | escape }}</p>{% endif %}
<div class="advising-grid">
{% for advisor in advising.people %}
<div class="advisor">
{% if advisor.photo %}<img class="photo-frame photo-frame-small advisor-photo" src="{{ advisor.photo | url }}" alt="{{ advisor.name | escape }}" width="112" height="112" loading="lazy" decoding="async">{% endif %}
<div class="advisor-details">
<h3 class="advisor-name">{% if advisor.url %}<a href="{{ advisor.url | url }}">{{ advisor.name | escape }}</a>{% else %}{{ advisor.name | escape }}{% endif %}</h3>
{% if advisor.title %}<p><strong>{{ advisor.title | escape }}</strong></p>{% endif %}
{% if advisor.role %}<p><strong>{{ advisor.role | escape }}</strong></p>{% endif %}
{% if advisor.email %}<p><a href="mailto:{{ advisor.email | escape }}"><span aria-hidden="true">{% include "icons/envelope.svg" %}</span><span>{{ advisor.email | escape }}</span></a></p>{% endif %}
</div>
</div>
{% endfor %}
</div>
</section>
{% endif %}
