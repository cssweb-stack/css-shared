{# Page-specific hero assignments live in src/_data/heroes.json. #}
{% set assignedHero = heroes.pages[page.url] %}
{% if not assignedHero %}{% set assignedHero = faculty_heroes.pages[page.url] %}{% endif %}
{% if assignedHero %}
{% set heroImage = '/_media/heros/' + assignedHero.image %}
<section class="page-hero page-hero--layered" {% if site.hero.decorative %}aria-hidden="true"{% else %}role="region" aria-label="{{ assignedHero.alt | default('Satellite imagery of ' + assignedHero.location) | escape }}"{% endif %}{% if assignedHero.position %} style="--hero-position: {{ assignedHero.position | escape }};"{% endif %}>
<div class="page-hero-image" style="background-image: url('{{ heroImage | url }}');"></div>
<div class="page-hero-pattern" style="background-image: url('{{ '/_media/branding/uh-pattern-vert-5-black.svg' | url }}');"></div>
{% if assignedHero.location and site.hero.showLocation != false %}<div class="hero-location">{{ assignedHero.location | escape }}</div>{% endif %}
</section>
{% else %}
{# Unassigned pages retain their existing hero. #}
<section class="page-hero" {% if site.hero.decorative %}aria-hidden="true"{% else %}role="img" aria-label="{{ heroAlt | default('Decorative geographical landscape') | escape }}"{% endif %} style="background-image: url('{{ (hero | default(site.defaultHero)) | url }}');"></section>
{% endif %}
