{% if site.courseResources | length %}
<nav class="course-resources" aria-label="{{ site.shortName | escape }} course resources">
<div class="grid-two content-narrow">
{% for resource in site.courseResources %}<a class="button button-green" href="{{ resource.url | url }}">{{ site.shortName | escape }} {{ resource.label | escape }}</a>{% endfor %}
</div>
</nav>
{% endif %}
